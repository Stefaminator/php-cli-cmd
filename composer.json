{
  "name": "stefaminator/php-cli-cmd",
  "type": "library",
  "description": "The PHP CLI CMD library",
  "keywords": ["cli", "cmd"],
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Stefaminator\\": "src/Stefaminator/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Stefaminator\\Cli\\Test\\": "tests/Stefaminator/Cli/Test/"
    }
  },
  "require": {
    "php": "^8.3",
    "corneltek/getoptionkit": "~2.0",
    "ext-json": "*"
  },
  "require-dev": {
    "roave/security-advisories": "dev-master",
    "phpunit/phpunit": "^11.0",
    "ext-mbstring": "*",
    "squizlabs/php_codesniffer": "^4.0",
    "phpstan/phpstan": "^2.3"
  }
}
